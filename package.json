{
  "name": "copclip",
  "version": "0.1.0",
  "description": "A lightweight Electron clipboard manager for macOS.",
  "private": true,
  "author": "CopClip contributors",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:sqlite:electron && electron-vite dev",
    "dev:debug": "npm run rebuild:sqlite:electron && COPCLIP_DEBUG=1 electron-vite dev",
    "open:popup": "electron . --open-popup",
    "rebuild:sqlite:electron": "npm_config_runtime=electron npm_config_target=$(node -p \"require('electron/package.json').version\") npm_config_disturl=https://electronjs.org/headers npm rebuild better-sqlite3 --loglevel=error",
    "rebuild:sqlite:node": "npm rebuild better-sqlite3",
    "build": "tsc --noEmit && electron-vite build",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:mac:dir": "npm run build && electron-builder --mac dir",
    "test": "npm run rebuild:sqlite:node && vitest run",
    "test:watch": "npm run rebuild:sqlite:node && vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^12.9.0",
    "electron-store": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
